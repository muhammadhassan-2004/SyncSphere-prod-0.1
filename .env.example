# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=<YOUR_APP_URL>

# Server Configuration
PORT=3000
NODE_ENV=development

# Cloudinary Storage Configuration (obtain from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>
CLOUDINARY_URL=cloudinary://<YOUR_CLOUDINARY_API_KEY>:<YOUR_CLOUDINARY_API_SECRET>@<YOUR_CLOUDINARY_CLOUD_NAME>

# SMTP Email Configuration (e.g. Gmail App Password, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<YOUR_SMTP_USER_EMAIL>
SMTP_PASS=<YOUR_SMTP_APP_PASSWORD>
SMTP_FROM=<YOUR_SMTP_FROM_EMAIL>

# Firebase Configuration
FIREBASE_PROJECT_ID=<YOUR_FIREBASE_PROJECT_ID>
# Firebase Service Account Key (JSON string or Base64 encoded JSON)
# Required for server-side Firebase Auth admin operations (such as OTP-based direct password updates)
FIREBASE_SERVICE_ACCOUNT=<YOUR_FIREBASE_SERVICE_ACCOUNT_JSON_OR_BASE64>
# Optional: Path to service account file if using file-based credential loading
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Stripe Payments Configuration
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_PUBLISHABLE_KEY=<YOUR_STRIPE_PUBLISHABLE_KEY>

# Client-Side Firebase API Key (Optional override)
VITE_FIREBASE_API_KEY=<YOUR_VITE_FIREBASE_API_KEY>
